{
  "name": "expense-tracker-backend",
  "version": "0.0.0",
  "description": "An API handle to expense tracking",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit --watch",
    "build": "rm -rf dist && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "author": "Alan Smith",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/request-context": "^6.2.1",
    "awilix": "^13.0.3",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.8.4",
    "knex": "^3.3.0",
    "mysql2": "^3.20.0",
    "node-cron": "^4.2.1",
    "qs": "^6.15.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/qs": "^6.15.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
